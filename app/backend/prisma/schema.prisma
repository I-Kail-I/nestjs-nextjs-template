generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: Only the "auth" schema is actually used — every model/enum targets it via
  // @@schema("auth"). "public" is declared but currently empty. Keep it if you plan
  // to add models to the default schema, otherwise it can be removed.
  schemas  = ["public", "auth"]
}

enum Role {
  user
  admin

  @@schema("auth")
}

model User {
  id         String    @id @default(uuid())
  first_name String
  last_name  String
  email      String    @unique
  password   String
  role       Role      @default(user)
  is_active  Boolean   @default(true) // This row incase if you want to implementing banning, delete this row if you dont need it
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  sessions   Session[]

  @@map("users")
  @@schema("auth")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
  @@schema("auth")
}
