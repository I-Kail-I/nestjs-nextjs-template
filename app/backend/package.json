{
  "name": "backend",
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "format": "bun run --cwd ../.. format:backend",
    "lint": "bun run --cwd ../.. lint:backend",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc ",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test ./test/auth.e2e-spec.ts",
    "db:migrate-dev": "prisma migrate dev --name",
    "db:migrate-prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.11.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "1.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "globals": "^17.0.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3"
  }
}
