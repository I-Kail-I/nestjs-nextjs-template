{
  "name": "template",
  "version": "1.0.0",
  "description": "",
  "author": "I-Kail-I",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=backend run start:dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "docker:up-prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose -f docker-compose.prod.yml down",
    "build-prod": "docker compose -f docker-compose.prod.yml build",
    "build:no-cache-prod": "docker compose -f docker-compose.prod.yml build --no-cache",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "format:backend": "biome check --write ./app/backend",
    "format:frontend": "biome check --write ./app/frontend",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:backend": "biome lint ./app/backend",
    "lint:frontend": "biome lint ./app/frontend",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --workspace=backend test",
    "test:frontend": "npm --workspace=frontend test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "concurrently": "^10.0.3"
  },
  "workspaces": [
    "./app/*"
  ]
}
